# CTFd (required for `run`; `local`/`solve` need nothing)
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=
# Or session auth instead of a token:
CTFD_USER=
CTFD_PASS=

# Race tuning (all optional)
RACE_MODELS=opencode/deepseek-v4.1-flash-free,opencode/glm-5.3-flash-free,opencode/big-pickle,opencode/beam-free,opencode/mimo-v2.6-flash-free
RACE_PER_CHALLENGE=3
MAX_CHALLENGES=4
MAX_ATTEMPTS=3
SOLVER_TIMEOUT=1800
POLL_INTERVAL=15
